# Configuração de chave do Google Gemini (Somente Server-Side)
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configuração de chave do OpenRouter (Opcional para modelos gratuitos)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
